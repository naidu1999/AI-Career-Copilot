[TEMPLATE]
APP_NAME=Karna OS
APP_VERSION=1.1.0
APP_ENV=development
HOST=127.0.0.1
PORT=8000
PUBLIC_BASE_URL=
TRUST_PROXY_HEADERS=false
CRON_SECRET=
DEPLOYMENT_MODE=local
SESSION_COOKIE_NAME=karna_session
REFRESH_COOKIE_NAME=karna_refresh
SESSION_COOKIE_SECURE=true
DATABASE_PATH=data/karna_os.db
UPLOAD_DIR=data/uploads
BACKUP_DIR=data/backups
MAX_UPLOAD_MB=10

# Optional Supabase migration target. Local SQLite works without these.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DATABASE_URL=

# AI is optional. Matching works fully without any AI provider.
# Choose: rules, ollama, litellm, openai_compatible
AI_PROVIDER=rules
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=
AI_TIMEOUT_SECONDS=60
AI_ROUTING_PRESET=free_first
AI_ALLOW_PAID=false
AI_MAX_ATTEMPTS=4
AI_LOCAL_FALLBACK=true
AI_CIRCUIT_FAILURES=3
AI_CIRCUIT_COOLDOWN_SECONDS=300

# Free unlimited option: run Ollama locally (https://ollama.com) — no keys, no quotas.
#   1) install Ollama  2) `ollama pull qwen2.5:7b`  3) set AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Google — first cloud fallback (free-tier key from aistudio.google.com)
GEMINI_API_KEY=
# Groq — free, fast AI. Get a key at https://console.groq.com/keys and paste it after =
GROQ_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# OpenRouter — second cloud fallback (free models available; openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# OpenAI — paid, keep disabled until needed
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic — paid, keep disabled until needed
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# xAI/Grok — paid, requires a Karna OS provider update
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=

# Optional job aggregators. Public ATS sources need no key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Personal-local scheduler. It runs only while Karna OS is running.
SCAN_ENABLED=true
SCAN_HOUR_LOCAL=8
DEFAULT_FRESHNESS_HOURS=48
QUALIFIED_SCORE=70
REVIEW_SCORE=55
TIMEZONE=Asia/Kolkata

# Continuity and retention. SQLite remains authoritative in personal-local mode.
CLOUD_SYNC_ENABLED=false
SECONDARY_DATABASE_URL=
BACKUP_DAILY_RETENTION=7
BACKUP_WEEKLY_RETENTION=4
BACKUP_MONTHLY_RETENTION=6
RATE_LIMIT_PER_MINUTE=120
INACTIVITY_DELETION_ENABLED=false

# Optional: enable LinkedIn profile import (your own profile only) via ScrapingDog
SCRAPINGDOG_API_KEY=
